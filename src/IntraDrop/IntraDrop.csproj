<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net8.0-windows: Windows 10/11용, net48: Windows 7 SP1+용 -->
    <TargetFrameworks>net8.0-windows;net48</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>IntraDrop</RootNamespace>
    <AssemblyName>IntraDrop</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.7.2</Version>
    <Company>yunhyok</Company>
    <Product>IntraDrop</Product>
    <Description>인트라넷 파일 전송 트레이 프로그램</Description>
    <SatelliteResourceLanguages>ko</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- Windows 7은 시스템 DPI 인식을 매니페스트로 선언 (SetHighDpiMode API 없음) -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- 공유 암호를 DPAPI(CurrentUser)로 보호해 저장 -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="Microsoft.CSharp" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <!-- .NET Framework 4.8 Developer Pack 없이도 net48 빌드 가능하게 하는 참조 어셈블리 -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="IntraDrop.Tests" />
    <Content Include="Help\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
